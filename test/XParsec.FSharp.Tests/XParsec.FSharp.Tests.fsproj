<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- Fixtures are found via __SOURCE_DIRECTORY__, which a CI (deterministic) build maps to /_/ -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ParserDebugFixtures.fs" />
    <Compile Include="GoldenFiles.fs" />
    <Compile Include="TestHelpers.fs" />
    <Compile Include="KeywordTests.fs" />
    <Compile Include="NumericTests.fs" />
    <Compile Include="LexingTests.fs" />
    <Compile Include="ParserTests.fs" />
    <Compile Include="ConstructorBodyTests.fs" />
    <Compile Include="CorpusReport.fs" />
    <Compile Include="InitializationTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="Expecto.FsCheck" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XParsec.FSharp\XParsec.FSharp.fsproj" />
  </ItemGroup>
</Project>
